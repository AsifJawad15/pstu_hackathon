  "panels": [
    {
      "type": "stat", "title": "Regional API request rate", "id": 1,
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "requests/s", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "type": "stat", "title": "P0/P1 incidents accepted", "id": 2,
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(incident_intake_total{priority=~\"P0|P1\"})", "legendFormat": "critical accepted", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Unpublished transactional events", "id": 3,
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "emergency_outbox_unpublished_events", "legendFormat": "retained locally", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 100 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Production integrations", "id": 4,
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "emergency_integration_up", "legendFormat": "{{integration}}", "refId": "A" },
        { "expr": "emergency_optimizer_up", "legendFormat": "python optimizer", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }], "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "textMode": "auto" }
    },
    {
      "type": "timeseries", "title": "HTTP traffic by status", "id": 5,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 18, "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Decision and allocation activity", "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "targets": [
        { "expr": "sum by (mode) (rate(decision_total[1m]))", "legendFormat": "decision {{mode}}", "refId": "A" },
