PORT=8181
HOST=127.0.0.1
REGION_ID=region-a
DATABASE_PATH=./data/emergency.db
EMERGENCY_API_TOKEN=replace-with-a-secret
COMMAND_SIGNING_KEY=replace-with-at-least-32-random-bytes
EDGE_SPOOL_KEY_HEX=replace-with-64-hex-characters
P0_QUEUE_CAPACITY=1024
GENERAL_QUEUE_CAPACITY=4096
AUTO_ALLOCATE=true

# Required by the full Docker production demonstration.
POSTGRES_PASSWORD=replace-with-a-random-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
OPTIMIZER_SHARED_SECRET=replace-with-a-random-secret

# Optional when running the API directly; Docker Compose supplies internal endpoints.
# POSTGRES_URL=postgresql://emergency:password@127.0.0.1:5432/emergency
# KAFKA_BROKERS=127.0.0.1:9092
# REDIS_URL=redis://127.0.0.1:6379
# ETCD_ENDPOINTS=http://127.0.0.1:2379
# OPTIMIZER_URL=http://127.0.0.1:8090
# OPTIMIZER_DEADLINE_MS=40
